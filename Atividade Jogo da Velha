// O nosso tabuleiro 3x3
let tabuleiro = [
    ["", "", ""],
    ["", "", ""],
    ["", "", ""]
];

let jogadorAtual = "X";


function fazerJogada(linha, coluna) {

    // Verifica se já está ocupado
    if (tabuleiro[linha][coluna] !== "") {
        alert("Esta posição já está ocupada!");
        return;
    }

    // Marca a jogada
    tabuleiro[linha][coluna] = jogadorAtual;

    // Atualiza a tela
    atualizarTela();

    // Verifica se alguém ganhou
    if (verificarVitoria()) {
        document.getElementById("mensagem").innerText =
            "Jogador " + jogadorAtual + " venceu!";
        
        alert("Jogador " + jogadorAtual + " venceu!");

        return; // Para o jogo
    }

    // Troca o jogador
    if (jogadorAtual === "X") {
        jogadorAtual = "O";
    } else {
        jogadorAtual = "X";
    }

    // Atualiza mensagem
    document.getElementById("mensagem").innerText =
        "Vez do jogador: " + jogadorAtual;
}


// Função para verificar vitória
function verificarVitoria() {

    // Verificar linhas
    for (let i = 0; i < 3; i++) {
        if (
            tabuleiro[i][0] !== "" &&
            tabuleiro[i][0] === tabuleiro[i][1] &&
            tabuleiro[i][1] === tabuleiro[i][2]
        ) {
            return true;
        }
    }

    // Verificar colunas
    for (let i = 0; i < 3; i++) {
        if (
            tabuleiro[0][i] !== "" &&
            tabuleiro[0][i] === tabuleiro[1][i] &&
            tabuleiro[1][i] === tabuleiro[2][i]
        ) {
            return true;
        }
    }

    // Verificar diagonal principal
    if (
        tabuleiro[0][0] !== "" &&
        tabuleiro[0][0] === tabuleiro[1][1] &&
        tabuleiro[1][1] === tabuleiro[2][2]
    ) {
        return true;
    }

    // Verificar diagonal secundária
    if (
        tabuleiro[0][2] !== "" &&
        tabuleiro[0][2] === tabuleiro[1][1] &&
        tabuleiro[1][1] === tabuleiro[2][0]
    ) {
        return true;
    }

    // Se ninguém venceu
    return false;
}


function atualizarTela() {

    const celulas = document.getElementsByClassName("celula");

    let indice = 0;

    for (let l = 0; l < 3; l++) {
        for (let c = 0; c < 3; c++) {

            celulas[indice].innerText = tabuleiro[l][c];

            indice++;
        }
    }
}
